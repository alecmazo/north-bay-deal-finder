# Copy to .env.local — never commit real values

# --- Client (Vite) ---
# demo | api
VITE_DATA_MODE=demo
# e.g. https://north-bay-api.example.com  (no trailing slash)
VITE_API_BASE_URL=

# --- Server / Terminal Grok ---
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Pick one listings provider (server-only)
RENTCAST_API_KEY=
ATTOM_API_KEY=

# Optional admin sync protection
SYNC_SECRET=

# Auth (only if using Better Auth / Grok broker on Vercel deploy)
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=
